<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!-- Exact wake-ups (design §5). Granted at install on API 33+; the app is sideloaded. -->
    <uses-permission android:name="android.permission.USE_EXACT_ALARM" />
    <!-- Re-arm the wake-up after a reboot (FR-9.2). -->
    <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED" />
    <!-- Reminder and alarm notifications (design §7). Runtime permission; T11 requests it. -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <!-- The alarm notification's full-screen intent (FR-3.2, design §7). -->
    <uses-permission android:name="android.permission.USE_FULL_SCREEN_INTENT" />
    <!-- Setup checklist (T11): the battery-optimisation exemption dialog. Sideloaded, never on Play. -->
    <uses-permission
        android:name="android.permission.REQUEST_IGNORE_BATTERY_OPTIMIZATIONS"
        tools:ignore="BatteryLife" />
    <!-- Lists the app under Settings > Usage access (T9 reads the usage log). -->
    <uses-permission
        android:name="android.permission.PACKAGE_USAGE_STATS"
        tools:ignore="ProtectedPermissions" />

    <application
        android:name=".PillReminderApp"
        android:allowBackup="false"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:icon="@mipmap/ic_launcher"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:label="@string/app_name"
        android:supportsRtl="true"
        android:theme="@style/Theme.PillReminder">

        <activity
            android:name=".ui.MainActivity"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <receiver
            android:name=".platform.receivers.WakeupReceiver"
            android:exported="false" />

        <!-- Notification buttons (design §7). Reached only through the app's own PendingIntents. -->
        <receiver
            android:name=".platform.receivers.ActionReceiver"
            android:exported="false" />

        <receiver
            android:name=".platform.receivers.SystemEventsReceiver"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.BOOT_COMPLETED" />
                <action android:name="android.intent.action.MY_PACKAGE_REPLACED" />
                <action android:name="android.intent.action.TIME_SET" />
                <action android:name="android.intent.action.TIMEZONE_CHANGED" />
            </intent-filter>
        </receiver>
    </application>

</manifest>
